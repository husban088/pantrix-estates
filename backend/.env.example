# Is file ko copy karke .env bana lein (setup.bat / setup.sh ye khud kar dete hain)
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Dashboard login: false = dashboard sab ke liye khula (default), true = login zaroori
REQUIRE_LOGIN=false

# Login tab use hoga jab REQUIRE_LOGIN=true ho
ADMIN_EMAIL=admin@pantrix.com
ADMIN_PASSWORD=Admin@123
JWT_SECRET=change-this-to-any-long-random-text

# Cloudinary (optional - khali ho to images backend/uploads me save hongi)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Firestore (optional - khali ho to data backend/data/db.json me save hoga)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional microservices (band hon tab bhi site chalegi)
PYTHON_URL=http://localhost:8001
JAVA_URL=http://localhost:8002
DOTNET_URL=http://localhost:8003
